{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Extended user data for customers and drivers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "driver", "admin"] },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "online", "busy", "offline"] },
        "verified": { "type": "boolean" },
        "vehicleId": { "type": "string" },
        "currentRideId": { "type": "string" },
        "rating": { "type": "number" },
        "totalTrips": { "type": "number" },
        "bio": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Ride": {
      "title": "Ride",
      "description": "A real-time ride transaction.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "driverId": { "type": "string" },
        "pickup": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "destination": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["requested", "accepted", "arrived", "started", "completed", "cancelled"] },
        "vehicleType": { "type": "string", "enum": ["economy", "premium", "suv"] },
        "estimatedFare": { "type": "number" },
        "actualFare": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "pickup", "destination", "status", "createdAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicle details for drivers.",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "model": { "type": "string" },
        "color": { "type": "string" },
        "plateNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["economy", "premium", "suv"] },
        "active": { "type": "boolean" }
      },
      "required": ["driverId", "model", "plateNumber", "type"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Dynamic content for the website.",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImage": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "DriverApplication": {
      "title": "Driver Application",
      "description": "Application data for potential drivers.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "vehicleModel": { "type": "string" },
        "licenseDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phoneNumber", "vehicleModel", "licenseDetails"]
    },
    "Review": {
      "title": "Ride Review",
      "description": "Rating and feedback left by customers after a ride.",
      "type": "object",
      "properties": {
        "rideId": { "type": "string" },
        "customerId": { "type": "string" },
        "driverId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rideId", "customerId", "driverId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "User profiles and statuses."
    },
    "/rides/{rideId}": {
      "schema": "Ride",
      "description": "Real-time ride records."
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Registered vehicles."
    },
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Dynamic site content."
    },
    "/bookings/{bookingId}": {
      "schema": "Ride",
      "description": "Legacy/Manual bookings (using Ride schema for compatibility)."
    },
    "/driver_applications/{applicationId}": {
      "schema": "DriverApplication",
      "description": "Potential driver applications."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback and ratings for drivers."
    }
  }
}
