rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safe for list operations (no get() calls)
    function isSystemAdmin() {
      return isSignedIn() && 
        (request.auth.token.email.lower() == "flust786@gmail.com"); 
    }

    // This one uses get(), use ONLY for non-list operations
    function isDatabaseAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSystemAdmin() || isDatabaseAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSystemAdmin(); 
      allow create: if isOwner(userId) && request.resource.data.role in ['customer', 'driver'];
      allow update: if (isOwner(userId) && 
                       request.resource.data.role == resource.data.role &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // Legacy Users support
    match /users/{userId} {
      allow get: if isOwner(userId) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow write: if isOwner(userId) || isSystemAdmin();
    }

    // Rides Collection
    match /rides/{rideId} {
      function isValidRide(data) {
        return data.customerId == request.auth.uid &&
               data.status == 'requested' &&
               data.pickup.address is string &&
               data.destination.address is string;
      }

      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested' || // Drivers need to see details of requested rides
        isSystemAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested' || // Allowed for drivers to search
        isSystemAdmin()
      );

      allow create: if isSignedIn() && isValidRide(request.resource.data);

      allow update: if isSignedIn() && (
        // Driver accepting a requested ride
        (resource.data.status == 'requested' && 
         request.resource.data.status == 'accepted' && 
         request.resource.data.driverId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverId', 'acceptedAt'])) ||
        
        // Driver progressing the ride
        (resource.data.driverId == request.auth.uid && 
         request.resource.data.status in ['arrived', 'started', 'completed'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'startedAt', 'completedAt'])) ||

        // Customer or Driver cancelling
        (request.resource.data.status == 'cancelled' && 
         (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid)) ||

        isAdmin()
      );
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update: if isSystemAdmin() || isDatabaseAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow delete: if isSystemAdmin() || isDatabaseAdmin();
    }

    // Bookings (Manual/Legacy)
    match /bookings/{bookingId} {
      allow get: if isSystemAdmin();
      allow list: if isSystemAdmin(); 
      allow create: if true; // Public booking form
      allow update, delete: if isSystemAdmin();
    }

    // Site Content
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isDatabaseAdmin();
    }

    // Driver Applications
    match /driver_applications/{applicationId} {
      allow create: if true; // Public application form
      allow read, update, delete: if isSystemAdmin() || isDatabaseAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return isSignedIn() &&
               data.rideId is string &&
               data.customerId == request.auth.uid &&
               data.driverId is string &&
               data.rating is number &&
               data.rating >= 1 && data.rating <= 5 &&
               data.createdAt is string;
      }

      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || resource.data.driverId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || resource.data.driverId == request.auth.uid);
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if isAdmin();
    }
  }
}
